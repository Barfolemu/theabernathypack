# Postgres connection string (direct, not pooled - see README.md for why)
DATABASE_URL=

# Used locally for S3 presigned URLs and any `aws` CLI work against this project
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Gmail OAuth2 credentials for sending email (password reset, pack invites)
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Base URL used to build links inside outgoing emails
APP_URL=http://localhost:3000
